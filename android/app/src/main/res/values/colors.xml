<?xml version="1.0" encoding="utf-8"?>
<!--
  There was no colors.xml here at all. styles.xml referenced @color/colorPrimary
  and @color/colorPrimaryDark, and those resolved to Capacitor's library
  defaults, so the status bar and system chrome were whatever the framework
  happened to ship rather than anything to do with this app.

  These match the web theme tokens (color-bg-dark for the chrome, color-primary
  for accents), so the native frame and the WebView inside it are the same app.

  Note for editors: an XML comment may not contain a double hyphen, so the CSS
  variable names are written here without their leading dashes. Including them
  fails the resource merger with a message that does not mention comments.
-->
<resources>
    <color name="colorPrimary">#0A0E12</color>
    <color name="colorPrimaryDark">#070A0D</color>
    <color name="colorAccent">#14E0C8</color>
    <!-- Behind the WebView, so a slow first paint shows the app's own ground
         rather than a white flash. -->
    <color name="background">#0A0E12</color>
</resources>
